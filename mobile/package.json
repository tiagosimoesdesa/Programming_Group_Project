{
  "name": "beerreal",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "preview": "expo start --web --port 8082 --localhost",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript ../backend/openapi.json -o src/generated/api.ts",
    "test:e2e": "uv --directory ../backend run python -m scripts.browser_test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "expo": "^58.0.26",
    "expo-camera": "~58.0.14",
    "expo-crypto": "~58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.4",
    "expo-font": "~58.0.12",
    "expo-file-system": "~58.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "openapi-typescript": "^7.10.1",
    "playwright-core": "1.65.1",
    "prettier": "^3.10.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.32"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
