DATABASE_URL=sqlite:///./beerreal.db
# Generate with: uv run python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-at-least-32-random-characters
PUBLIC_URL=http://192.168.1.10:8000
CORS_ORIGINS=["http://localhost:8082","http://127.0.0.1:8082"]
STORAGE_MODE=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=beerreal
# Bounds Argon2 memory during login spikes; 2 is suitable for a small Render service.
PASSWORD_HASH_CONCURRENCY=2
# Optional: prepares seven days of searched celebrations; a bundled observance covers missing dates.
OPENAI_API_KEY=
OPENAI_DAILY_FACT_MODEL=gpt-6.2-astra
DAILY_CELEBRATION_TIMEZONE=Europe/Lisbon
# Production: DATABASE_URL=postgresql+psycopg://... (Supabase session pooler)
# Production: STORAGE_MODE=supabase and PUBLIC_URL=https://your-service.onrender.com
# Production: CORS_ORIGINS=["https://your-web-service.onrender.com"]
