DATABASE_URL=sqlite:///./beerreal.db
# Generate with: uv run python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-at-least-32-random-characters
PUBLIC_URL=http://192.168.1.10:8000
STORAGE_MODE=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=beerreal
# Production: DATABASE_URL=postgresql+psycopg://... (Supabase session pooler)
# Production: STORAGE_MODE=supabase and PUBLIC_URL=https://your-service.onrender.com
